{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=web-catalog",
  "outputDirectory": "apps/web-catalog/dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pedidolisto-jet.vercel.app" }],
      "destination": "https://pedidolisto.mx/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.pedidolisto.mx" }],
      "destination": "https://pedidolisto.mx/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
