rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Leer un campo inexistente aborta la evaluacion de la regla, asi que ownerId
    // siempre se lee con esta funcion. Devuelve null cuando el negocio no tiene
    // dueno, ya sea porque el campo no existe, es null o quedo como texto vacio.
    function ownerOf(businessId) {
      let data = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      return 'ownerId' in data && data.ownerId != '' ? data.ownerId : null;
    }

    function isOwner(businessId) {
      return request.auth != null && ownerOf(businessId) == request.auth.uid;
    }

    function isUnownedBusiness(businessId) {
      return ownerOf(businessId) == null;
    }

    function canClaimBusiness(businessId) {
      return request.auth != null
        && isUnownedBusiness(businessId)
        && request.resource.data.ownerId == request.auth.uid;
    }

    function canSeedUnownedBusiness(businessId) {
      return request.auth != null
        && isUnownedBusiness(businessId)
        && !('ownerId' in request.resource.data);
    }

    function canSeedUnownedMenu(businessId) {
      return request.auth != null && isUnownedBusiness(businessId);
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if isOwner(businessId) || canClaimBusiness(businessId) || canSeedUnownedBusiness(businessId);
      allow delete: if isOwner(businessId);

      match /categories/{catId} {
        allow read: if true;
        allow write: if isOwner(businessId) || canSeedUnownedMenu(businessId);
      }

      match /products/{productId} {
        allow read: if true;
        allow write: if isOwner(businessId) || canSeedUnownedMenu(businessId);
      }

      match /orders/{orderId} {
        allow read: if isOwner(businessId);
        allow create: if true;
        allow update: if isOwner(businessId);
        allow delete: if isOwner(businessId);
      }
    }
  }
}
