rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Mismo criterio que firestore.rules: un campo ownerId ausente, null o vacio
    // significa negocio sin dueno, y nunca se lee de forma que aborte la regla.
    function ownerOf(businessId) {
      let data = firestore.get(/databases/(default)/documents/businesses/$(businessId)).data;
      return 'ownerId' in data && data.ownerId != '' ? data.ownerId : null;
    }

    function isOwner(businessId) {
      return request.auth != null && ownerOf(businessId) == request.auth.uid;
    }

    function isUnownedBusiness(businessId) {
      return ownerOf(businessId) == null;
    }

    function canSeedUnowned(businessId) {
      return request.auth != null && isUnownedBusiness(businessId);
    }

    match /businesses/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(businessId) || canSeedUnowned(businessId);
    }
  }
}
