{
  "expo": {
    "name": "PedidoListo Cocina",
    "slug": "pedido-listo-cocina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pedidolisto.cocina"
    },
    "android": {
      "package": "com.pedidolisto.cocina",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir fotos de tus platillos desde la galeria.",
          "cameraPermission": "Permite tomar fotos de tus platillos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "63d13b16-4248-4fcc-84d6-ad57ff2bf498"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/63d13b16-4248-4fcc-84d6-ad57ff2bf498"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
