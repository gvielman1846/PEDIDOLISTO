{
  "expo": {
    "name": "PedidoListo",
    "slug": "pedido-listo-cocina",
    "version": "1.4.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.pedidolisto.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "mx.pedidolisto.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#F97316",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir fotos de tus productos desde la galeria.",
          "cameraPermission": "Permite tomar fotos de tus productos.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "63d13b16-4248-4fcc-84d6-ad57ff2bf498"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/63d13b16-4248-4fcc-84d6-ad57ff2bf498"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
